# Required
DISCORD_TOKEN=your-bot-token-here

# Optional: register slash commands to ONE server (instant updates, good for testing).
# Leave empty to register globally (can take up to an hour to appear).
GUILD_ID=

# Optional tuning
DB_PATH=./data/tickets.db
MAX_TRANSCRIPT_MESSAGES=5000
# Seconds a user must wait between opening tickets
CREATE_COOLDOWN_SECONDS=10
